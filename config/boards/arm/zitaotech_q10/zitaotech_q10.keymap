#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/rgb.h>


#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <dt-bindings/zmk/keys.h>

#define DEFAULT 0
#define SYM 1
#define UPPER 2
#define FN 3

#define SL_TO(layer) &sl_to layer layer //tap -> sticky layer, double tap -> to layer

&sl {
    release-after-ms = <3000>;
    ignore-modifiers;
    };


/ {
    behaviors {
        td0: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <400>;
            bindings = <&mkp LCLK>, <&bt BT_CLR>;
        };
    };
    behaviors {
        td_boot_out: td_boot_out {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <400>;           
            bindings = <&bootloader>, <&out OUT_TOG>;
        };
    };
    behaviors {
        tdc_to_SYM: td_comma_to_layer {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <400>;
            bindings = <&mt DLLR SEMI>, <&to SYM>;
        };
    };
    behaviors {
        td1: tap_stickylayer_doubletap_tolayer_1 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <400>;
            bindings = <&sl 1>, <&to 1>;
        };
    };
    behaviors {
        td2: tap_stickylayer_doubletap_tolayer_2 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <400>;
            bindings = <&sl 2>, <&to 2>;
        };
    };
    behaviors {
        td3: tap_stickylayer_doubletap_tolayer_3 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <400>;
            bindings = <&sl FN>, <&to FN>;
        };
    };
    behaviors {
    sk_kp: behavior_sk_kp {
        compatible = "zmk,behavior-hold-tap";
        #binding-cells = <2>;
        flavor = "hold-preferred";      
        tapping-term-ms = <400>;       
        bindings = <&kp &sk>;          /* hold=kp, tap=sticky key */
        };
    };
    behaviors {
        ht: hold_tap_tap_preferred {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;    /* hold only after the tapping term, so fast rolls stay taps */
        };
    };
    behaviors {
        scroll_cw: scroll_toggle_caps_word {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp SLCK>, <&caps_word>;    /* tap: trackpad scroll mode, Shift+tap: Caps Word */
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <500>;
            bindings = <&out &kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {

            bindings = <
//         --------------------------------------------------------------------------------------------------------------------------         
//         |    Shoulder Key1    |                                                                             |    Shoulder Key2    |     
// |         Call key      |      Blackberry Key        |    Trackpad    |             Back Key                |             Endcall Key          |
// |     Q      |     W    |     E    |     R    |      T      |       Y        |       U        |        I        |       O      |      P        |     
// |     A      |     S    |     D    |     F    |      G      |       H        |       J        |        K        |       L      |      ←        |  
// |     alt    |     Z    |     X    |     C    |      V      |       B        |       N        |        M        |       $      |    Enter      |   
//        |         aA     |         0           |           SPACE              |         SYM         |        aA          |       
//        -----------------------------------------------------------------------------------------------------------------

                 &mkp LCLK                                                                                          &mkp RCLK
    &scroll_cw              &kp LGUI                            &mkp LCLK                          &ht K_BACK ESC                    &lt FN TAB
    &kp Q              &kp W      &kp E       &kp R     &kp T         &kp Y             &kp U            &kp I            &kp O            &kp P
    &kp A              &kp S      &kp D       &kp F     &kp G         &kp H             &kp J            &kp K            &kp L            &kp BSPC
    &sk LALT           &kp Z      &kp X       &kp C     &kp V         &kp B             &kp N            &kp M            &ht DLLR SEMI    &kp ENTER
    &sk_kp LSHFT LSHFT      &sk_kp LCTRL LCTRL                        &kp SPACE                          &td1                              &td2
            >;
        };

        sym_layer {

            bindings = <        
                 &trans                                                                                             &trans
    &trans                  &td3                                &mkp LCLK                          &kp F5                            &kp EQUAL
    &kp HASH     &kp N1     &kp N2      &kp N3    &ht LBKT LPAR &ht RBKT RPAR     &kp UNDER        &kp MINUS        &kp PLUS         &kp AT
    &kp STAR     &kp N4     &kp N5      &kp N6    &kp SLASH     &kp COLON         &kp SEMI         &kp APOS         &kp DQT          &kp DEL
    &trans       &kp N7     &kp N8      &kp N9    &kp QMARK     &kp EXCL          &kp COMMA        &kp DOT          &kp DLLR         &kp ENTER
    &trans                  &kp N0                              &kp SPACE                          &to DEFAULT                       &to UPPER
            >;
        };

        upper_layer {

            bindings = <
                 &trans                                                                                             &trans
    &trans                  &kp LC(ESC)                              &mkp MCLK                      &kp LA(LEFT)                     &kp LA(RIGHT)
    &kp HOME     &kp UP     &kp END     &kp PG_UP       &kp LC(LA(TAB))     &kp PRCNT        &kp LT           &kp GT           &kp PIPE         &kp EQUAL
    &kp LEFT     &kp DOWN   &kp RIGHT   &kp PG_DN       &kp BSLH            &kp AMPS         &kp LBRC         &kp RBRC         &kp CARET        &kp BSPC
    &trans       &kp LC(LEFT) &kp LC(RIGHT) &kp LC(BSPC) &kp LC(DEL)        &kp TILDE        &kp LBKT         &kp RBKT         &kp GRAVE        &kp ENTER
    &trans                  &trans                                          &kp SPACE                         &to SYM                           &to DEFAULT
            >;
        };

        fn_layer {

            bindings = <
                 &trans                                                                                             &trans
    &bt BT_SEL 0           &bt BT_SEL 1                        &td0                          &bt BT_SEL 2                     &bt BT_SEL 3
    &kp F11      &kp F1    &kp F2      &kp F3     &kp LC(LS(ESC)) &none      &kp K_APP       &none           &kp CLCK         &ext_power EP_TOG
    &kp F12      &kp F4    &kp F5      &kp F6     &rgb_ug RGB_BRD &bl BL_DEC &rgb_ug RGB_TOG &bl BL_INC      &rgb_ug RGB_BRI  &none
    &trans       &kp F7    &kp F8      &kp F9     &none        &none         &none           &sys_reset      &td_boot_out     &none
    &trans                 &trans                              &kp F10                       &to DEFAULT                      &to DEFAULT
            >;
        };
    };
};