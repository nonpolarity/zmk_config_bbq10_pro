#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/rgb.h>


#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <dt-bindings/zmk/keys.h>

#define DEFAULT 0
#define SYM 1
#define UPPER 2
#define FKEYS 3

#define SL_TO(layer) &sl_to layer layer //tap -> sticky layer, double tap -> to layer

&sl {
    release-after-ms = <3000>;
    ignore-modifiers;
    };

&sk {
    release-after-ms = <2000>;
};


/ {
    behaviors {
        /* system keys on the navigation layer: a single tap does nothing, a double tap runs them */
        td_tp_pwr: double_tap_trackpad_power {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <400>;
            bindings = <&none>, <&ext_power EP_TOG>;    /* trackpad on/off: EXT_POWER powers the trackpad sensor; the state is saved and kept after a reboot */
        };
        td_bt_clr: double_tap_bt_clear {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <400>;
            bindings = <&none>, <&bt BT_CLR>;
        };
        td_out: double_tap_output_toggle {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <400>;
            bindings = <&none>, <&out OUT_TOG>;
        };
        td_reset: double_tap_reset {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <400>;
            bindings = <&none>, <&sys_reset>;
        };
        td_boot: double_tap_bootloader {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <400>;
            bindings = <&none>, <&bootloader>;
        };
    };
    behaviors {
        tdc_to_SYM: td_comma_to_layer {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <400>;
            bindings = <&mt DLLR SEMI>, <&to SYM>;
        };
    };
    behaviors {
        td1: tap_stickylayer_doubletap_tolayer_1 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <400>;
            bindings = <&sl 1>, <&to 1>;
        };
    };
    behaviors {
        tdf: tap_stickylayer_doubletap_tolayer_fkeys {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <400>;
            bindings = <&sl FKEYS>, <&tog FKEYS>;    /* Fn on the navigation layer (V, right of F9): tap = Fn for the next key only, double-tap = Fn on/off; letter keys without an Fn function are blank */
        };
    };
    behaviors {
        lp_to: long_press_to_layer {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";       /* only holding for tapping-term-ms counts as a long press */
            tapping-term-ms = <500>;
            bindings = <&to>, <&sl>;          /* &lp_to HOLD TAP: short press = layer TAP for the next key only, long press = lock layer HOLD */
        };
    };
    behaviors {
    sk_kp: behavior_sk_kp {
        compatible = "zmk,behavior-hold-tap";
        #binding-cells = <2>;
        flavor = "hold-preferred";      
        tapping-term-ms = <400>;       
        bindings = <&kp &sk>;          /* hold=kp, tap=sticky key */
        };
    };
    behaviors {
        ht: hold_tap_tap_preferred {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;    /* hold only after the tapping term, so fast rolls stay taps */
        };
    };
    behaviors {
        scroll_cw: scroll_toggle_caps_word {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp SLCK>, <&caps_word>;    /* tap: trackpad scroll mode, Shift+tap: Caps Word */
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };
    behaviors {
        bspc_del: backspace_delete {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp BSPC>, <&kp DEL>;    /* tap: Backspace, Shift+tap: Delete (Shift is not sent); same on every layer */
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <500>;
            bindings = <&out &kp>;
        };
    };
    behaviors {
        tpc: trackpad_click {
            compatible = "zmk,behavior-trackpad-click";
            #binding-cells = <2>;
            bindings = <&mkp>, <&mkp>;
            long-press-ms = <1000>;    /* &tpc CLICK LONG: press = CLICK, press and move = drag, hold still = LONG */
            move-threshold = <6>;      /* trackpad counts that turn a press into a drag */
        };
    };
    behaviors {
        /* symbol layer: Shift + key types the symbol shown in the key's top-right corner on the diagram */
        sym_1: shift_1_grave {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N1>, <&kp GRAVE>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        sym_2: shift_2_tilde {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N2>, <&kp TILDE>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        sym_8: shift_8_backslash {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N8>, <&kp BSLH>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        sym_9: shift_9_pipe {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N9>, <&kp PIPE>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        sym_plus: shift_plus_equal {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp PLUS>, <&kp EQUAL>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        sym_under: shift_underscore_lbkt {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp UNDER>, <&kp LBKT>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        sym_minus: shift_minus_rbkt {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp MINUS>, <&kp RBKT>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        sym_semi: shift_semicolon_lbrc {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp SEMI>, <&kp LBRC>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        sym_apos: shift_apostrophe_rbrc {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp APOS>, <&kp RBRC>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };
    combos {
        compatible = "zmk,combos";
        combo_nav {
            timeout-ms = <100>;
            key-positions = <40 41>;    /* the symbol layer key and the right aA (Shift), bottom right */
            bindings = <&lp_to UPPER UPPER>;   /* short press: navigation for the next key only, hold 0.5 s: lock navigation */
            layers = <DEFAULT SYM>;
        };
        combo_nav_exit {
            timeout-ms = <100>;
            key-positions = <40 41>;
            bindings = <&to DEFAULT>;   /* on the navigation and F-key layers, both keys together return to layer 0 */
            layers = <UPPER FKEYS>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {

            bindings = <
//         --------------------------------------------------------------------------------------------------------------------------         
//         |    Shoulder Key1    |                                                                             |    Shoulder Key2    |     
// |         Call key      |      Blackberry Key        |    Trackpad    |             Back Key                |             Endcall Key          |
// |     Q      |     W    |     E    |     R    |      T      |       Y        |       U        |        I        |       O      |      P        |     
// |     A      |     S    |     D    |     F    |      G      |       H        |       J        |        K        |       L      |      ←        |  
// |     alt    |     Z    |     X    |     C    |      V      |       B        |       N        |        M        |       $      |    Enter      |   
//        |         aA     |         0           |           SPACE              |         SYM         |        aA          |       
//        -----------------------------------------------------------------------------------------------------------------

                 &mkp LCLK                                                                                          &mkp RCLK
    &scroll_cw              &kp LGUI                            &tpc LCLK RCLK                     &ht K_BACK ESC                    &kp TAB
    &kp Q              &kp W      &kp E       &kp R     &kp T         &kp Y             &kp U            &kp I            &kp O            &kp P
    &kp A              &kp S      &kp D       &kp F     &kp G         &kp H             &kp J            &kp K            &kp L            &bspc_del
    &sk LALT           &kp Z      &kp X       &kp C     &kp V         &kp B             &kp N            &kp M            &kp DLLR         &kp ENTER
    &sk LSHFT               &sk_kp LCTRL LCTRL                        &kp SPACE                          &td1                              &sk RSHFT
            >;
        };

        sym_layer {

            bindings = <        
                 &trans                                                                                             &trans
    &trans                  &trans                              &trans                             &trans                            &trans
    &kp HASH     &sym_1     &sym_2      &kp N3    &kp LPAR      &kp RPAR          &sym_under       &sym_minus       &sym_plus        &kp AT
    &kp STAR     &kp N4     &kp N5      &kp N6    &kp SLASH     &kp COLON         &sym_semi        &sym_apos        &kp DQT          &trans
    &trans       &kp N7     &sym_8      &sym_9    &kp QMARK     &kp EXCL          &kp COMMA        &kp DOT          &trans           &kp ENTER
    &trans                  &kp N0                              &kp SPACE                          &to DEFAULT                       &trans
            >;
        };

        upper_layer {

            bindings = <
                 &trans                                                                                             &trans
    &trans                  &trans                              &trans                             &trans                            &trans
    &kp HOME     &kp UP     &kp END     &kp PG_UP       &kp LC(LA(TAB))     &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3     &td_tp_pwr
    &kp LEFT     &kp DOWN   &kp RIGHT   &kp PG_DN       &rgb_ug RGB_BRD     &bl BL_DEC       &rgb_ug RGB_TOG  &bl BL_INC       &rgb_ug RGB_BRI  &trans
    &trans       &none      &none       &none           &tdf                &td_bt_clr       &td_out          &td_reset        &td_boot         &kp ENTER
    &trans                  &sk_kp LCTRL LCTRL                              &kp SPACE                         &to SYM                           &trans
            >;
        };

        fkeys_layer {

            bindings = <
                 &trans                                                                                             &trans
    &trans                  &trans                              &trans                             &trans                            &trans
    &kp F11      &kp F1    &kp F2      &kp F3     &kp LC(LS(ESC)) &none      &kp K_APP       &none           &none            &none
    &kp F12      &kp F4    &kp F5      &kp F6     &none        &none         &none           &none           &none            &trans
    &trans       &kp F7    &kp F8      &kp F9     &trans       &none         &none           &none           &none            &trans
    &trans                 &sk_kp LCTRL LCTRL                  &kp F10                       &trans                           &trans
            >;
        };
    };
};
